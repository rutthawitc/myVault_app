name: Release (Multi-Platform)

on:
  push:
    tags:
      - 'v*'

env:
  CARGO_TERM_COLOR: always

jobs:
  build-and-release:
    name: Build and Release on ${{ matrix.os }}
    runs-on: ${{ matrix.os }}
    permissions:
      contents: write
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: windows-latest
            artifact_name: my_vault.exe
            artifact_path: target/release/my_vault.exe
          - os: macos-latest
            artifact_name: my_vault-macos
            artifact_path: target/release/my_vault
          - os: ubuntu-latest
            artifact_name: my_vault-linux
            artifact_path: target/release/my_vault

    steps:
    - uses: actions/checkout@v4

    - name: Install Rust
      uses: dtolnay/rust-toolchain@stable

    - name: Build release
      run: cargo build --release --verbose

    - name: Run tests before release
      run: cargo test --release --verbose

    - name: Prepare artifact
      shell: bash
      run: |
        mkdir -p release-artifacts
        cp ${{ matrix.artifact_path }} release-artifacts/${{ matrix.artifact_name }}
        chmod +x release-artifacts/${{ matrix.artifact_name }}

    - name: Create GitHub Release (Windows only)
      if: matrix.os == 'windows-latest'
      uses: ncipollo/release-action@v1
      with:
        artifacts: "release-artifacts/*"
        draft: false
        prerelease: false
        generateReleaseNotes: false
        body: |
          # MyVault Release

          ## Available Downloads
          - **Windows**: `my_vault.exe` - Run directly, no installation needed
          - **macOS**: `my_vault-macos` - Intel and Apple Silicon support
          - **Linux**: `my_vault-linux` - Portable executable

          ## Features
          - ✅ ChaCha20-Poly1305 AEAD encryption (military-grade)
          - ✅ Batch operations (99+ files, 14GB+ tested)
          - ✅ Custom lock icon
          - ✅ Multi-select with shift+click
          - ✅ Real-time execution timing
          - ✅ Cross-platform support (Windows, macOS, Linux)

          ## Installation

          ### Windows
          Download `my_vault.exe` and run it directly. No installation required!

          ### macOS
          Download `my_vault-macos`, make it executable, and run:
          ```bash
          chmod +x my_vault-macos
          ./my_vault-macos
          ```

          ### Linux
          Download `my_vault-linux`, make it executable, and run:
          ```bash
          chmod +x my_vault-linux
          ./my_vault-linux
          ```

          See [QUICKSTART.md](https://github.com/rutthawitc/myVault_app/blob/main/docs/QUICKSTART.md) for detailed setup.

          ## Security
          - Military-grade encryption: ChaCha20-Poly1305
          - Brute-force resistant: Argon2id hashing
          - Memory-safe: Written in Rust
          - Open source: Fully auditable

          ## Performance
          - Tested with 99 files (14GB total)
          - Constant memory usage
          - ~2 minutes for 14GB of files

          ## Documentation
          - [Quick Start](https://github.com/rutthawitc/myVault_app/blob/main/docs/QUICKSTART.md)
          - [Deployment Guide](https://github.com/rutthawitc/myVault_app/blob/main/docs/DEPLOYMENT_GUIDE.md)
          - [Full Changelog](https://github.com/rutthawitc/myVault_app/blob/main/CHANGELOG.md)

    - name: Upload to release (macOS and Linux)
      if: matrix.os != 'windows-latest'
      uses: softprops/action-gh-release@v1
      with:
        files: release-artifacts/*
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
